{
  "name": "piano",
  "version": "0.0.0",
  "private": true,
  "description": "A Claude Code First piano: play scores, watch them fall, learn to play them.",
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace apps/desktop",
    "build": "npm run build --workspace apps/desktop",
    "smoke": "npm run smoke --workspace apps/desktop",
    "typecheck": "tsc -b",
    "check:format-ownership": "node scripts/check-format-ownership.mjs",
    "selfcheck": "npm run selfcheck --workspace apps/desktop",
    "check:colour-tokens": "node scripts/check-colour-tokens.mjs",
    "check": "npm run typecheck && npm run lint && npm test",
    "test": "vitest run --project score-format --project ipc --project library --project sample-pack --project mcp-server --project desktop-main --project renderer",
    "test:live": "vitest run --project renderer-browser --project desktop-live --project premise",
    "premise:record": "node apps/desktop/scripts/premise-record.mjs",
    "test:all": "vitest run",
    "test:watch": "vitest --project score-format --project ipc --project library --project sample-pack --project mcp-server --project desktop-main --project renderer",
    "lint": "eslint . && prettier --check . && npm run check:format-ownership && npm run check:colour-tokens && npm run check:schema && npm run check:plugin",
    "lint:fix": "eslint . --fix && prettier --write .",
    "format": "prettier --write .",
    "package": "npm run build && npm run package --workspace apps/desktop",
    "icon": "node build/make-icon.mjs",
    "schema": "npm run schema --workspace packages/score-format",
    "pack:samples": "npm run build-pack --workspace packages/sample-pack --",
    "check:schema": "vite-node scripts/check-schema-fresh.mts",
    "plugin": "node apps/mcp-server/scripts/bundle.mjs",
    "check:plugin": "node apps/mcp-server/scripts/bundle.mjs --check"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@vitest/browser": "^5.0.1",
    "@vitest/browser-playwright": "^5.0.1",
    "eslint": "^10.11.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^30.1.0",
    "playwright": "^1.63.0",
    "prettier": "^3.9.8",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite-node": "^6.0.0",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=20.11"
  },
  "allowScripts": {
    "electron": true,
    "esbuild": true,
    "unrs-resolver": true
  }
}
