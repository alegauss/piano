{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "lib": ["ES2023"],
    // Node, because a library is files on a disk; read by the MCP server and by
    // the app's main process, and never by the renderer, which asks main.
    "types": ["node"]
  },
  "include": ["src/**/*.ts"],
  "references": [{ "path": "../score-format" }, { "path": "../ipc" }]
}
