{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "formatVersion": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "metadata": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "composer": {
          "type": "string"
        },
        "arranger": {
          "type": "string"
        },
        "key": {
          "type": "string"
        },
        "difficulty": {
          "type": "number",
          "minimum": 1,
          "maximum": 10
        },
        "level": {
          "type": "string",
          "enum": [
            "beginner",
            "intermediate",
            "advanced"
          ]
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "durationSeconds": {
          "type": "number",
          "minimum": 0
        },
        "provenance": {
          "type": "object",
          "properties": {
            "source": {
              "type": "string",
              "minLength": 1
            },
            "licence": {
              "type": "string",
              "minLength": 1
            },
            "attribution": {
              "type": "string"
            }
          },
          "required": [
            "source",
            "licence"
          ]
        },
        "generator": {
          "type": "string"
        }
      },
      "required": [
        "title"
      ]
    },
    "timing": {
      "type": "object",
      "properties": {
        "ticksPerQuarter": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "tempo": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "tick": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "microsecondsPerQuarter": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "tick",
              "microsecondsPerQuarter"
            ]
          }
        },
        "timeSignatures": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "tick": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "numerator": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "denominator": {
                "anyOf": [
                  {
                    "type": "number",
                    "const": 1
                  },
                  {
                    "type": "number",
                    "const": 2
                  },
                  {
                    "type": "number",
                    "const": 4
                  },
                  {
                    "type": "number",
                    "const": 8
                  },
                  {
                    "type": "number",
                    "const": 16
                  },
                  {
                    "type": "number",
                    "const": 32
                  }
                ]
              }
            },
            "required": [
              "tick",
              "numerator",
              "denominator"
            ]
          }
        },
        "pickupTicks": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "pitch": {
            "type": "integer",
            "minimum": 0,
            "maximum": 127
          },
          "spelling": {
            "type": "string",
            "pattern": "^[A-G](#{1,2}|b{1,2})?(-1|\\d)$"
          },
          "start": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "duration": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "velocity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 127
          },
          "voice": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "hand": {
            "type": "string",
            "enum": [
              "left",
              "right"
            ]
          },
          "finger": {
            "anyOf": [
              {
                "type": "number",
                "const": 1
              },
              {
                "type": "number",
                "const": 2
              },
              {
                "type": "number",
                "const": 3
              },
              {
                "type": "number",
                "const": 4
              },
              {
                "type": "number",
                "const": 5
              }
            ]
          },
          "part": {
            "type": "string",
            "minLength": 1
          },
          "articulation": {
            "type": "string",
            "enum": [
              "staccato",
              "tenuto",
              "accent",
              "marcato"
            ]
          }
        },
        "required": [
          "pitch",
          "start",
          "duration",
          "velocity"
        ]
      }
    },
    "parts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "colour": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "role": {
            "type": "string",
            "enum": [
              "melody",
              "accompaniment",
              "bass",
              "other"
            ]
          },
          "visible": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "name"
        ]
      }
    },
    "expression": {
      "type": "object",
      "properties": {
        "pedals": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "tick": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "pedal": {
                "type": "string",
                "enum": [
                  "sustain",
                  "sostenuto",
                  "softUnaCorda"
                ]
              },
              "value": {
                "type": "integer",
                "minimum": 0,
                "maximum": 127
              }
            },
            "required": [
              "tick",
              "pedal",
              "value"
            ]
          }
        },
        "dynamics": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "tick": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "level": {
                "type": "string",
                "enum": [
                  "ppp",
                  "pp",
                  "p",
                  "mp",
                  "mf",
                  "f",
                  "ff",
                  "fff"
                ]
              },
              "rampFrom": {
                "type": "string",
                "enum": [
                  "ppp",
                  "pp",
                  "p",
                  "mp",
                  "mf",
                  "f",
                  "ff",
                  "fff"
                ]
              },
              "rampStart": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "tick",
              "level"
            ]
          }
        }
      }
    },
    "sections": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema0"
      }
    },
    "arrangements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
