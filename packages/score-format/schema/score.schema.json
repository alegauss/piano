          },
          "voices": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "drop": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "tempoScale": {
            "type": "number",
            "exclusiveMinimum": 0
