                "pitch": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 127
                },
                "spelling": {
                  "type": "string",
                  "pattern": "^[A-G](#{1,2}|b{1,2})?(-1|\\d)$"
                },
                "start": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "duration": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "velocity": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 127
                },
                "voice": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "hand": {
                  "type": "string",
                  "enum": [
                    "left",
                    "right"
                  ]
                },
                "finger": {
                  "anyOf": [
                    {
                      "type": "number",
                      "const": 1
                    },
                    {
                      "type": "number",
                      "const": 2
                    },
                    {
                      "type": "number",
                      "const": 3
                    },
                    {
                      "type": "number",
                      "const": 4
                    },
                    {
                      "type": "number",
                      "const": 5
                    }
                  ]
                },
                "part": {
                  "type": "string",
                  "minLength": 1
                },
                "articulation": {
                  "type": "string",
                  "enum": [
                    "staccato",
                    "tenuto",
                    "accent",
                    "marcato"
                  ]
                }
              },
              "required": [
