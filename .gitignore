# roadkeep's vendored engine — restored by `roadkeep install --vendor`
.roadkeep/

# dependencies and build output
node_modules/
dist/
out/
release/

# local environment
.env
.env.local
*.log

# os
.DS_Store
Thumbs.db

# machine-local Claude Code settings (absolute paths)
.claude/settings.local.json

# TypeScript project-reference build info
.tsbuild/
*.tsbuildinfo

# Per-run Electron profiles: dev, smoke, the self-check and the live tests each
# get their own so they never fight over one disk cache. A glob rather than a
# list, because the list is what let .test-profile through.
*-profile/
